<gpx xmlns="http://www.topografix.com/GPX/1/1" version="1.1" creator="Haiku Routes">
  <metadata>
    <desc>Short walking variant of the Kurzeme Planning Region Kazdanga park GPS track. Starts at the original trailhead, follows the recorded approach to the southern loop and returns along the same access path. The two recordings of the shared junction differ by 1.3 m.</desc>
    <link href="https://kurzemesregions.lv/wp-content/uploads/2019/04/Kazdanga_Park_Nature_Trail.gpx" />
  </metadata>
